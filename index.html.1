<!DOCTYPE html>
<html lang="bs">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Royal Taste Restaurant | Premium Dining</title>
    <!-- Google Fonts za moderan izgled -->
    <link
        href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Poppins:wght@300;400;600&display=swap"
        rel="stylesheet">
    <style>
        /* --- CSS DIZAJN (MODERAN & RESPONSIVE) --- */

        /* Reset osnova */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Poppins', sans-serif;
            background-color: #101010;
            /* Skoro crna za luksuz */
            color: #fff;
            line-height: 1.6;
        }

        a {
            text-decoration: none;
            transition: 0.3s;
        }

        ul {
            list-style: none;
        }

        /* --- HERO SEKCIJA (PRVI UTISAK) --- */
        .hero {
            height: 100vh;
            background: linear-gradient(rgba(0, 0, 0, 0.6), rgba(16, 16, 16, 1)),
                url('https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?q=80&w=1920&auto=format&fit=crop');
            background-size: cover;
            background-position: center;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            padding: 0 20px;
        }

        .hero h1 {
            font-family: 'Playfair Display', serif;
            /* Elegantan font za naslove */
            font-size: 4rem;
            color: #cda45e;
            /* Zlatna boja */
            margin-bottom: 15px;
            animation: fadeInDown 1s ease;
        }

        .hero p {
            font-size: 1.2rem;
            font-weight: 300;
            color: #eee;
            margin-bottom: 30px;
            max-width: 600px;
            animation: fadeInUp 1s ease 0.5s;
            animation-fill-mode: both;
        }

        /* Moderno dugme */
        .btn-book {
            font-family: 'Poppins', sans-serif;
            font-weight: 600;
            font-size: 14px;
            letter-spacing: 1px;
            display: inline-block;
            padding: 12px 32px;
            border-radius: 50px;
            transition: 0.5s;
            color: #fff;
            border: 2px solid #cda45e;
            background: rgba(205, 164, 94, 0.1);
            animation: fadeInUp 1s ease 1s;
            animation-fill-mode: both;
        }

        .btn-book:hover {
            background: #cda45e;
            color: #101010;
        }

        /* --- MENI SEKCIJA --- */
        .menu-section {
            padding: 100px 20px;
            max-width: 1200px;
            margin: 0 auto;
        }

        .section-title {
            text-align: center;
            margin-bottom: 60px;
        }

        .section-title h2 {
            font-family: 'Playfair Display', serif;
            font-size: 2.5rem;
            color: #fff;
            position: relative;
            display: inline-block;
            padding-bottom: 10px;
        }

        .section-title h2::after {
            content: '';
            position: absolute;
            display: block;
            width: 60px;
            height: 2px;
            background: #cda45e;
            bottom: 0;
            left: calc(50% - 30px);
        }

        .menu-container {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 30px;
        }

        /* Kartice jela */
        .menu-item {
            background: #1a1a1a;
            border-radius: 15px;
            overflow: hidden;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            border: 1px solid #2a2a2a;
        }

        .menu-item:hover {
            transform: translateY(-10px);
            box-shadow: 0 10px 30px rgba(205, 164, 94, 0.2);
        }

        .menu-img {
            width: 100%;
            height: 200px;
            object-fit: cover;
        }

        .menu-content {
            padding: 20px;
        }

        .menu-content h3 {
            font-family: 'Playfair Display', serif;
            font-size: 1.5rem;
            color: #cda45e;
            margin-bottom: 10px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .price {
            font-family: 'Poppins', sans-serif;
            font-size: 1.2rem;
            color: #fff;
            font-weight: 600;
        }

        .menu-content p {
            font-size: 0.9rem;
            color: #aaa;
            font-weight: 300;
        }

        /* --- RESPONSIVE PODESAVANJA --- */
        @media (max-width: 768px) {
            .hero h1 {
                font-size: 2.5rem;
            }

            .hero p {
                font-size: 1rem;
            }

            .menu-container {
                grid-template-columns: 1fr;
            }
        }

        /* Animacije */
        @keyframes fadeInDown {
            0% {
                opacity: 0;
                transform: translateY(-20px);
            }

            100% {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @keyframes fadeInUp {
            0% {
                opacity: 0;
                transform: translateY(20px);
            }

            100% {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* --- NAVIGACIJA --- */
        .navbar {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            background: rgba(16, 16, 16, 0.95);
            padding: 15px 40px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            z-index: 1000;
            border-bottom: 1px solid #2a2a2a;
            backdrop-filter: blur(10px);
        }

        .navbar-logo {
            font-family: 'Playfair Display', serif;
            font-size: 1.5rem;
            color: #cda45e;
            font-weight: 700;
        }

        .navbar-links {
            display: flex;
            gap: 30px;
        }

        .navbar-links a {
            color: #fff;
            font-weight: 400;
            font-size: 0.95rem;
            letter-spacing: 1px;
            text-transform: uppercase;
        }

        .navbar-links a:hover {
            color: #cda45e;
        }

        /* --- MOBILNO DUGME ZA POZIV --- */
        .mobile-call-btn {
            display: none;
            position: fixed;
            bottom: 20px;
            right: 20px;
            background: #cda45e;
            color: #101010;
            padding: 15px 25px;
            border-radius: 50px;
            font-weight: 600;
            font-size: 1rem;
            z-index: 1000;
            box-shadow: 0 5px 20px rgba(205, 164, 94, 0.4);
            animation: pulse 2s infinite;
        }

        .mobile-call-btn:hover {
            background: #fff;
            color: #101010;
        }

        @keyframes pulse {
            0% {
                box-shadow: 0 0 0 0 rgba(205, 164, 94, 0.7);
            }

            70% {
                box-shadow: 0 0 0 15px rgba(205, 164, 94, 0);
            }

            100% {
                box-shadow: 0 0 0 0 rgba(205, 164, 94, 0);
            }
        }

        @media (max-width: 768px) {
            .mobile-call-btn {
                display: block;
            }

            .navbar-links {
                display: none;
            }

            .navbar {
                padding: 15px 20px;
            }
        }

        /* --- FOOTER --- */
        .footer {
            background: #0a0a0a;
            padding: 60px 20px 30px;
            border-top: 2px solid #cda45e;
        }

        .footer-content {
            max-width: 1200px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 40px;
        }

        .footer-section h4 {
            font-family: 'Playfair Display', serif;
            color: #cda45e;
            font-size: 1.3rem;
            margin-bottom: 20px;
        }

        .footer-section p,
        .footer-section li {
            color: #aaa;
            font-size: 0.95rem;
            margin-bottom: 10px;
            font-weight: 300;
        }

        .footer-section ul {
            list-style: none;
        }

        .footer-section a {
            color: #aaa;
        }

        .footer-section a:hover {
            color: #cda45e;
        }

        .footer-bottom {
            text-align: center;
            padding-top: 40px;
            margin-top: 40px;
            border-top: 1px solid #2a2a2a;
        }

        .footer-bottom p {
            color: #666;
            font-size: 0.85rem;
        }

        .map-container {
            width: 100%;
            height: 200px;
            border-radius: 10px;
            overflow: hidden;
            margin-top: 15px;
        }

        .map-container iframe {
            width: 100%;
            height: 100%;
            border: none;
        }
    </style>
</head>

<body>

    <!-- NAVIGACIJA -->
    <nav class="navbar">
        <div class="navbar-logo">Royal Taste</div>
        <div class="navbar-links">
            <a href="#home">Početna</a>
            <a href="#menu">Meni</a>
            <a href="#lokacija">Lokacija</a>
        </div>
    </nav>

    <!-- DUGME ZA POZIV (MOBILNO) -->
    <a href="tel:+38760000000" class="mobile-call-btn">📞 Pozovi odmah</a>

    <!-- HERO SEKCIJA -->
    <section id="home" class="hero">
        <h1>Royal Taste</h1>
        <p>Iskusite savršenstvo okusa u srcu grada. Spoj tradicije i moderne kuhinje.</p>
        <a href="#menu" class="btn-book">Pogledaj Meni</a>
    </section>

    <!-- MENI SEKCIJA -->
    <section id="menu" class="menu-section">
        <div class="section-title">
            <h2>Naši Specijaliteti</h2>
        </div>

        <div class="menu-container">
            <!-- Jelo 1 -->
            <div class="menu-item">
                <img src="https://images.unsplash.com/photo-1594041680534-e8c8cdebd659?q=80&w=600&auto=format&fit=crop"
                    alt="Premium Steak" class="menu-img">
                <div class="menu-content">
                    <h3>Premium Steak <span class="price">45 KM</span></h3>
                    <p>Odležani biftek na žaru sa mladim krompirom i sosom od tartufa.</p>
                </div>
            </div>

            <!-- Jelo 2 -->
            <div class="menu-item">
                <img src="https://images.unsplash.com/photo-1551183053-bf91a1d81141?q=80&w=600&auto=format&fit=crop"
                    alt="Mediteranska Pasta" class="menu-img">
                <div class="menu-content">
                    <h3>Mediteranska Pasta <span class="price">22 KM</span></h3>
                    <p>Domaća tjestenina sa plodovima mora, bijelim vinom i češnjakom.</p>
                </div>
            </div>

            <!-- Jelo 3 -->
            <div class="menu-item">
                <img src="https://images.unsplash.com/photo-1558030006-450675393462?q=80&w=600&auto=format&fit=crop"
                    alt="Teleći Odrezak" class="menu-img">
                <div class="menu-content">
                    <h3>Teleći Odrezak <span class="price">35 KM</span></h3>
                    <p>Sočni teleći odrezak sa gruntom, povrćem i domaćim sosom.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- FOOTER -->
    <footer id="lokacija" class="footer">
        <div class="footer-content">
            <div class="footer-section">
                <h4>Radno Vrijeme</h4>
                <ul>
                    <li>Ponedjeljak - Petak: 08:00 - 23:00</li>
                    <li>Subota - Nedjelja: 10:00 - 00:00</li>
                </ul>
            </div>
            <div class="footer-section">
                <h4>Kontakt</h4>
                <p>📍 Maršala Tita 45, Sarajevo</p>
                <p>📞 +387 60 123 4567</p>
                <p>✉️ info@royaltaste.ba</p>
            </div>
            <div class="footer-section">
                <h4>Lokacija</h4>
                <div class="map-container">
                    <iframe
                        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2877.123456789!2d18.4134!3d43.8563!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zNDPCsDUxJzE3LjYiTiAxOMKwMjQnNDQuNCJF!5e0!3m2!1sen!2sba!4v1234567890"
                        loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
                </div>
            </div>
        </div>
        <div class="footer-bottom">
            <p>&copy; 2024 Royal Taste Restaurant. Sva prava pridržana.</p>
        </div>
    </footer>

</body>

</html>